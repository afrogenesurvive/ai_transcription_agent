# Node.js
node_modules/
agent_runner/node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Environment
.env

# License master keys (maintainer-only, NEVER commit — see scripts/license.mjs)
dev-keys/

# License key management tooling (maintainer-only — never commit; code contains
# no secrets, but both scripts only make sense against the gitignored dev-keys/)
scripts/keymanage.mjs
scripts/license.mjs


# ── Node.js ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment files ──
.env
.env.local
.env.*.local
webapp/.env

# ── Logs ──
logs/
*.log
# Dev mirror logs (written to storage/logs/ in dev mode — also covered by storage/ rule above)


# ── Build output & local data ──
/safe/
dist/
# Generated build resources (Python backend + ffmpeg; produced by CI and build-python-backend.sh, not committed)
dist-resources/

# ── Transcription Agent Service (self-contained, gitignored) ──
transcription-agent/
.next/

# ── Runner ──
mcp/agent-runner/README.md
mcp/agent-runner/system-prompt.md

# ── Generated version file (branch name) ──
version.json

# ── Test artifacts ──
electron/test-results/
electron/docs/

# ── Transcription Agent Runtime ──
storage/
queue/transcription.jsonl

# ── Copilot chat history (local session logs, not committed) ──
chat.json

# ── Legacy MCP (reference only, not part of transcription system) ──
legacy_mcp/

# ── Agent Instructions (user-generated, not committed) ──
AGENTS.md
agent-runner/system-prompt.md

# ── Agent Config (live files — each user customizes these locally) ──
agent-config/pipeline.json
agent-config/tools.json
agent-config/system-prompt.md
agent-config/.defaults/
agent-config/.restart-flag

# ── Editor / IDE ──
.vscode/
.idea/
*.swp

# ── User-guide screenshot working copies ──
# Derived from docs/safe/user_guide_raw_screenshots/*.png by scripts/annotate_screenshots.py
# (downscaled with sips -Z 1400). Only the final annotated PNGs in docs/screenshots/user-guide/ are committed.
docs/screenshots/user-guide/raw/
*.swo
*~
.DS_Store

# ── OS files ──
Thumbs.db
Desktop.ini

# ── Dev monitor config (local-only, per-machine) ──
devmon.json

# ── Personal notes ──
notes.txt

# ── MCP dependencies (each mcp/* has its own node_modules) ──
mcp/*/node_modules/

# ── README files (exclude root README) ──
**/README.md
!/README.md
README_local.md

AGENTS.md
copilot-instructions.md

assets/private
*.tsbuildinfo
.cloudflared-url
.github/prompts

# Root safe/ (local build data) AND docs/safe/ (full internal docs) are ignored —
# neither ships to the public repo. docs/safe/ holds the full/sensitive versions;
# root docs/ keeps redacted public versions. docs/safe/ is bundled into the app
# (extraResources) and served in-app by the DevPanel Guide tab, not committed.
/safe/
docs/safe/

# Changelogs are rebuilt each save_progress (docs/safe/CHANGELOG.md -> redacted
# docs/CHANGELOG.md) and are not committed to the repo.
docs/CHANGELOG.md

# PyInstaller workpath (python-backend/build/ — intermediate build output, like dist-resources/)
python-backend/build/