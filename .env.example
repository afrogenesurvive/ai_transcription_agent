# ── Transcription Agent Configuration ──
#
# Copy this file to .env and fill in your values.
# The .env file is gitignored — your secrets stay local.
#
# Required:
#   DEEPSEEK_API_KEY   — LLM inference (unless using Ollama)
#
# Optional — gated models, delivery, auto-updates:
#   HUGGING_FACE_TOKEN — gated models (pyannote/speaker-diarization-3.1)
#   GMAIL_*            — email delivery credentials
#   TRELLO_*           — Trello card creation
#   GITHUB_TOKEN       — private repo auto-updates

# ── LLM Provider ──
# Required unless using Ollama.
DEEPSEEK_API_KEY=

# ── LLM Provider: "deepseek" (default) or "ollama" ──
# LLM_PROVIDER=deepseek
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=
# OLLAMA_NUM_CTX=32768

# ── Hugging Face (gated models) ──
# Required for pyannote/speaker-diarization-3.1
HUGGING_FACE_TOKEN=

# ── Gmail Delivery (optional) ──
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_USER=

# ── Trello Delivery (optional) ──
# TRELLO_KEY=
# TRELLO_TOKEN=

# ── GitHub (private repo auto-updates, optional) ──
# GITHUB_TOKEN=

# ── ASR Model ──
# WHISPER_MODEL_SIZE=medium
# EMBEDDING_PROVIDER=pyannote

# ── Pipeline ──
# PIPELINE_TIMEOUT_MINUTES=60
# GATE_RAW_REVIEW_ENABLED=true
# GATE_DELIVERY_REVIEW_ENABLED=true
# CUSTOM_DELIVERY_PER_MEETING=true
# KEEP_MODELS_WARM=false

# ── Diarization ──
# Floor for the diarization subprocess timeout (minutes). The effective budget
# auto-scales with audio length (default ~2x duration), so this is a minimum.
# DIARIZATION_TIMEOUT_MINUTES=60
# Seconds of diarization budget per second of audio (advanced; default 2.0).
# DIARIZATION_TIMEOUT_SCALE=2.0

# ── Alert Sound ──
# Optional override for the job-alert sound (WAV). Defaults (first existing wins):
# <repo>/sounds/alert.wav (dev), <resources>/sounds/alert.wav (packaged),
# or <userData>/sounds/alert.wav (writable override, no rebuild needed).
# ALERT_SOUND_PATH=

# ── Delivery Defaults ──
# DELIVERY_RECIPIENT_EMAILS=
# DELIVERY_EMAIL_SUBJECT=Meeting Summary: {title}
# DELIVERY_DRIVE_FOLDER=Meeting Transcripts

# ── In-app Guides ──
# Show annotated screenshots in the in-app User Guide (About → Guide) and Dev
# Guide (Dev → Guide). Toggle from Config → UI tab, or set here.
# USER_GUIDE_IMAGES_ENABLED=true
