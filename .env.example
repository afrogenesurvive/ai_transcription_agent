# ── LLM Provider ──
# Choose "deepseek" (API) or "ollama" (local)
LLM_PROVIDER=deepseek

# DeepSeek V4 (required if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-your-key-here

# Ollama (required if LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1:8b

# ── Gmail (for email delivery) ──
# GMAIL_CLIENT_ID=...
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
# GMAIL_USER=me

# ── Trello (for action item delivery) ──
# TRELLO_KEY=...
# TRELLO_TOKEN=...

# ── Transcription Backend ──
TRANSCRIPTION_HOST=127.0.0.1
TRANSCRIPTION_PORT=5001
WHISPER_MODEL_SIZE=medium
VOICEPRINT_THRESHOLD=0.75

# ── Bridge Server ──
BRIDGE_PORT=5010

# ── Agent Runner ──
AGENT_RUNNER_ENABLED=true
TASK_CHECK_INTERVAL=60000

# ── Sanitization ──
# Set to "true" to sanitize transcript text for prompt injection before it reaches the LLM.
# Third-party API responses (Gmail, Trello, Drive) are ALWAYS sanitized regardless of this flag.
TRANSCRIPTION_SANITIZE_PROMPT=false

# ── Performance Monitoring ──
# How often (in ms) the DevPanel's Performance tab refreshes CPU/memory metrics.
# Default: 10000 (10 seconds). Set to 0 to disable auto-refresh.
PERF_METRICS_POLL_INTERVAL=10000
