{
  "name": "transcription-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop UI for AI Meeting Transcription Agent",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -n renderer,main,electron --kill-others \"npm run dev:renderer\" \"npm run watch:main\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on http://localhost:5173 dist/main/index.js && electron .",
    "build": "tsc && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "dist:prepare": "bash ../scripts/download-nodejs.sh && bash ../scripts/build-python-backend.sh",
    "dist:win": "npm run dist:prepare && electron-builder --win",
    "dist:mac": "npm run dist:prepare && electron-builder --mac",
    "dist:linux": "npm run dist:prepare && electron-builder --linux"
  },
  "build": {
    "appId": "com.transcription.agent",
    "productName": "Transcription Agent",
    "publish": {
      "provider": "github",
      "owner": "afrogenesurvive",
      "repo": "ai_transcription_agent",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist-resources/python-backend",
        "to": "python-backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../dist-resources/node-bin",
        "to": "node-bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../bridge-server",
        "to": "bridge-server",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": "../agent-runner",
        "to": "agent-runner",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": null,
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis",
      "icon": null,
      "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": false,
        "deleteAppDataOnUninstall": true,
        "include": "build/cleanup.nsh"
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": null
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pidusage": "^4.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/pidusage": "^2.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
