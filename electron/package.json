{
  "name": "transcription-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop UI for AI Meeting Transcription Agent",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -n renderer,main,electron \"npm run dev:renderer\" \"npm run watch:main\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on http://localhost:5173 dist/main/index.js && nodemon --watch dist/main --ext js --exec \"electron .\"",
    "build": "tsc && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.transcription.agent",
    "productName": "Transcription Agent",
    "files": [
      "dist/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../python-backend",
        "to": "python-backend",
        "filter": [
          "**/*",
          "!venv/**",
          "!__pycache__/**"
        ]
      },
      {
        "from": "../bridge-server",
        "to": "bridge-server",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": null,
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis",
      "icon": null
    },
    "linux": {
      "target": "AppImage",
      "icon": null
    }
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
